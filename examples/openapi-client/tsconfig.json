{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "lib": [
            "ES2022",
            "DOM"
        ],
        "baseUrl": ".",
        "paths": {
            "@reduxjs/toolkit": [
                "./node_modules/@reduxjs/toolkit"
            ],
            "@reduxjs/toolkit/*": [
                "./node_modules/@reduxjs/toolkit/*"
            ]
        },
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}
