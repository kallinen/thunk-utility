{
    "name": "@kallinen/thunk-utility",
    "version": "0.8.0",
    "description": "TypeScript library for creating typed thunks.",
    "files": [
        "lib/**/*"
    ],
    "main": "lib/index.js",
    "module": "lib/index.mjs",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.mts",
                "default": "./lib/index.mjs"
            },
            "require": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        },
        "./lib/index": {
            "import": {
                "types": "./lib/index.d.mts",
                "default": "./lib/index.mjs"
            },
            "require": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        },
        "./lib/*": "./lib/*",
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsup --tsconfig tsconfig.production.json src --format cjs,esm --dts --out-dir lib",
        "test": "cross-env NODE_ENV=test jest --detectOpenHandles --config ./jest.config.js --colors --verbose --forceExit",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "tslint -p tsconfig.json",
        "prepublishOnly": "npm run test && npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kallinen/thunk-utility.git"
    },
    "author": "Kallinen Solutions Oy",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/kallinen/thunk-utility/issues"
    },
    "homepage": "https://github.com/kallinen/thunk-utility#readme",
    "peerDependencies": {
        "@reduxjs/toolkit": ">=2.0.0 <3.0.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "cross-env": "^7.0.3",
        "jest": "^29.0.3",
        "prettier": "^2.7.1",
        "ts-jest": "^29.0.5",
        "tslint": "^6.1.3",
        "tslint-config-prettier": "^1.18.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "directories": {
        "lib": "lib"
    }
}
